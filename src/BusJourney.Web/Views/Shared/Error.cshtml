@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<main class="wrap page">
    <div class="empty-state">
        <h2>Beklenmeyen bir hata oluştu</h2>
        @if (Model.ShowRequestId)
        {
            <p>İstek numarası: <code>@Model.RequestId</code></p>
        }
        <a class="search-button" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
    </div>
</main>
