@model LocationFieldModel
@* Origin / destination field. Behaviour is attached by wwwroot/js/location-autocomplete.js through the data-ac-* hooks. *@
<div class="search-field location-field" data-location-field="@Model.Key">
    <label class="field-label" for="@Model.Key-input">@Model.Label</label>
    <div class="field-row">
        <span class="route-dot route-dot--@Model.Key" aria-hidden="true"></span>
        <input id="@Model.Key-input" name="@(Model.Key)Name" class="field-input" type="text" value="@Model.Value?.Name"
               placeholder="Şehir veya ilçe yazın" autocomplete="off" spellcheck="false"
               role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="@Model.Key-list"
               data-ac-input />
    </div>
    <input type="hidden" name="@Model.InputName" value="@Model.Value?.Id" data-ac-value />
    <ul id="@Model.Key-list" class="suggestions" role="listbox" aria-label="@Model.Label" hidden data-ac-list></ul>
</div>
