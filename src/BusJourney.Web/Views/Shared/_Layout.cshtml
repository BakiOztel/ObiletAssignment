<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Otobüs Seferleri</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="wrap">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
                    <rect class="brand__plate" width="32" height="32" rx="7" />
                    <rect class="brand__bus" x="7" y="7" width="18" height="15" rx="3" />
                    <rect class="brand__bus" x="9" y="21" width="3" height="4" rx="1" />
                    <rect class="brand__bus" x="20" y="21" width="3" height="4" rx="1" />
                    <rect class="brand__plate" x="9.5" y="9.5" width="13" height="6" rx="1" />
                </svg>
                <span>Otobüs Seferleri</span>
            </a>
        </div>
    </header>

    @RenderBody()

    <footer class="site-footer">
        <div class="wrap">Sefer, saat ve fiyat bilgileri bilet sağlayıcısından anlık olarak alınır.</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
